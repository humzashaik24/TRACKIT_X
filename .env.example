# ---------------------------------------------------------------------------
# Trackit X — environment template
#
# Copy to `.env` for local development:   cp .env.example .env
# `.env` is git-ignored and MUST NEVER be committed.
#
# ---------------------------------------------------------------------------
# RULE: anything prefixed with EXPO_PUBLIC_ is INLINED INTO THE CLIENT BUNDLE
# and is therefore PUBLIC. Never put a secret behind an EXPO_PUBLIC_ prefix.
# ---------------------------------------------------------------------------


# ===========================================================================
# CLIENT-SAFE  (bundled into the mobile app and the web bundle)
# ===========================================================================

# Which environment this build points at: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Supabase project URL.
# Local dev (supabase start) prints this; default is http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase publishable (anon) key. Safe for clients: it carries no privileges
# of its own — every request it makes is still filtered by Row Level Security.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: enables verbose client-side logging. Never enable in production.
EXPO_PUBLIC_DEBUG_LOGGING=false


# ===========================================================================
# SERVER-ONLY SECRETS
#
# These are consumed exclusively by Supabase Edge Functions and by local
# tooling. They are NEVER read by the Expo app and NEVER prefixed with
# EXPO_PUBLIC_.
#
# In deployed environments they are set with:
#   supabase secrets set GEMINI_API_KEY=... --project-ref <ref>
#
# For local Edge Function development, place them in `supabase/.env`
# (also git-ignored) rather than here.
# ===========================================================================

# Supabase service role key — bypasses Row Level Security. Treat as root
# credentials for the database. Server-side only, always.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project URL as seen from inside an Edge Function.
SUPABASE_URL=http://127.0.0.1:54321

# Google Gemini API key. The AI reasoning engine is only ever called from
# Edge Functions, so this key never reaches a client.
GEMINI_API_KEY=

# Gemini model id used for reasoning. Verify the exact id against the current
# Google AI model list before deploying.
GEMINI_MODEL=gemini-2.5-flash

# Hard ceiling on tokens per AI run — a cost guardrail enforced server-side.
GEMINI_MAX_OUTPUT_TOKENS=4096

# Phase 38 data source. "demo" serves a fixed demonstration dataset
# (5 employees, 3 projects, 12 tasks) instead of querying the database, so the
# app can be developed with no Supabase project. "live" queries the real tables.
#
# Leave unset in development and it means "demo" - a fresh clone then runs with
# no setup. Unset anywhere else means "live". Production ALWAYS means "live" and
# ignores this variable, so a demo build cannot be promoted by copying .env.
#
# Demo mode changes where business records come from and nothing else. The AI
# provider, the Vault credential and the Gateway are all still real.
EXPO_PUBLIC_DATA_MODE=
